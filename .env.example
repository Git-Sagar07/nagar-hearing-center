# Leave empty / unset while there is no backend — the site runs in mock mode.
# Once the Express + MongoDB API is deployed, set this to its base URL, e.g.:
# VITE_API_BASE_URL=https://api.nagarhearingspeech.com
VITE_API_BASE_URL=

# Staff dashboard (yoursite.com/#admin) password while there's no real backend
# admin login yet. CHANGE THIS before sharing the site with clinic staff.
# Once real backend auth is added (see src/admin/adminService.js), this is
# no longer used.
VITE_ADMIN_DEMO_PASSWORD=nagar-admin
